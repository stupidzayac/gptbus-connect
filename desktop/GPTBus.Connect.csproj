<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>GPTBus-Connect</AssemblyName>
    <Version>1.2.2</Version>
    <PublishTrimmed>true</PublishTrimmed>
    <TrimMode>partial</TrimMode>
    <RuntimeIdentifiers>win-x64;win-arm64;linux-x64;linux-arm64;osx-x64;osx-arm64</RuntimeIdentifiers>
    <ApplicationIcon>gptbus.ico</ApplicationIcon>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia.Desktop" Version="11.3.23" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.3.23" />
    <PackageReference Include="Tomlyn" Version="0.19.0" />
    <TrimmerRootAssembly Include="Tomlyn" />
    <AvaloniaResource Include="bus.png" />
    <EmbeddedResource Include="../third_party/cc-switch/codex_native_responses_template.json" LogicalName="CodexModelTemplate" />
    <EmbeddedResource Include="../third_party/cc-switch/LICENSE" LogicalName="CCSwitchLicense" />
  </ItemGroup>
</Project>
